<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.snapcast.remote-client</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SUPPORT_DIR@/bin/snapclient</string>
    <string>tcp://@SOURCE_HOST@:1704</string>
    <string>--hostID</string>
    <string>@REMOTE_CLIENT_ID@</string>
    <string>--logsink</string>
    <string>file:@LOG_DIR@/client.log</string>
    <string>--logfilter</string>
    <string>*:info</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOMEBREW_BIN@:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/client.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/client.stderr.log</string>
</dict>
</plist>
