<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.snapcast.route</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOMEBREW_BIN@/SwitchAudioSource</string>
    <string>-s</string>
    <string>@CAPTURE_DEVICE@</string>
    <string>-t</string>
    <string>output</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
