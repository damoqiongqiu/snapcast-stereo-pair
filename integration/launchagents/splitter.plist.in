<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.snapcast.splitter</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOMEBREW_BIN@/snapcast-capture-blackhole</string>
    <string>--left-fifo</string>
    <string>@SUPPORT_DIR@/run/left.pcm</string>
    <string>--right-fifo</string>
    <string>@SUPPORT_DIR@/run/right.pcm</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOMEBREW_BIN@:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/splitter.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/splitter.stderr.log</string>
</dict>
</plist>
