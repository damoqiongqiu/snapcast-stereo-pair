<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.snapcast.wake-recovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SUPPORT_DIR@/bin/wake-recovery-listener</string>
    <string>@SUPPORT_DIR@/wake-recovery-local.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOMEBREW_BIN@:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/wake-recovery.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/wake-recovery.stderr.log</string>
</dict>
</plist>
