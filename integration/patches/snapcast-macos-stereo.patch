diff --git a/docs/installation.md b/docs/installation.md
new file mode 100644
index 00000000..0fad6abe
--- /dev/null
+++ b/docs/installation.md
@@ -0,0 +1,226 @@
+# Installation
+
+This guide assumes the repository that captures audio is called the source Mac
+and the second MacBook is called the remote Mac. Both can use any stable role
+names and either can be on the physical left.
+
+## Prerequisites
+
+Install Xcode Command Line Tools and Homebrew on the source Mac:
+
+```sh
+xcode-select --install
+```
+
+Install the runtime dependencies:
+
+```sh
+brew install --cask blackhole-2ch
+brew install switchaudio-osx portaudio cmake ninja pkgconf boost openssl@4 \
+  flac libogg libsoxr libvorbis opus
+```
+
+The included remote installer copies a locally built Snapclient binary, so both
+Macs should use the same CPU architecture. If they differ, build Snapclient on
+the remote Mac's architecture and adapt the copy step instead of using the
+prebuilt source-Mac binary.
+
+Configure SSH key authentication before remote installation:
+
+```sh
+ssh <ssh-user>@<remote-mac-address>
+```
+
+The installer uses normal SSH configuration and does not prompt for or store a
+password.
+
+## Clone Both Repositories
+
+The optional controller installer looks beside the runtime checkout by
+default:
+
+```sh
+git clone https://github.com/damoqiongqiu/snapcast-stereo-pair.git
+git clone https://github.com/damoqiongqiu/snapweb-stereo-pair.git
+cd snapcast-stereo-pair
+```
+
+If the controller lives elsewhere, set `SNAPWEB_SOURCE` when installing it.
+
+## Configure Roles
+
+Run the interactive configurator:
+
+```sh
+./integration/scripts/configure-pair.sh
+```
+
+Defaults and file values are documented in
+[`integration/config/pair.env.example`](../integration/config/pair.env.example).
+The resulting file is stored outside the repository:
+
+```text
+~/.config/snapcast-stereo-pair/pair.env
+```
+
+The relevant values are:
+
+```sh
+REMOTE_USER="<ssh-user>"
+REMOTE_HOST="<remote-mac-address>"
+SOURCE_HOST=""
+LEFT_IS_REMOTE=true
+CAPTURE_DEVICE="BlackHole 2ch"
+CAPTURE_DEVICE_UID="BlackHole2ch_UID"
+LOCAL_OUTPUT_DEVICE="BuiltInSpeakerDevice"
+NATIVE_OUTPUT_DEVICE_UID="BuiltInSpeakerDevice"
+REMOTE_OUTPUT_DEVICE_UID="BuiltInSpeakerDevice"
+LOCAL_CLIENT_ID="stereo-local"
+REMOTE_CLIENT_ID="stereo-remote"
+```
+
+Use `SOURCE_HOST=""` to detect the primary IPv4 address when configuring. Set it
+explicitly if the source Mac has multiple active interfaces.
+
+List CoreAudio outputs and their UIDs when choosing the local and native output
+devices:
+
+```sh
+SwitchAudioSource -a -t output
+```
+
+`CAPTURE_DEVICE_UID` is normalized to 100% before capture.
+`LOCAL_OUTPUT_DEVICE` selects and normalizes the source Mac's physical output.
+`REMOTE_OUTPUT_DEVICE_UID` performs the same step on the remote Mac.
+`NATIVE_OUTPUT_DEVICE_UID` is restored and normalized by native mode. The three
+output fields default to the built-in speaker.
+
+Environment variables override file values for automation:
+
+```sh
+PAIR_NONINTERACTIVE=1 \
+REMOTE_USER=tester \
+REMOTE_HOST=remote.local \
+SOURCE_HOST=192.0.2.10 \
+LEFT_IS_REMOTE=true \
+./integration/scripts/configure-pair.sh --print
+```
+
+`--print` resolves and displays the configuration without writing it. The
+address above is reserved for documentation and is not a real network target.
+
+## Build and Install Locally
+
+Build and validate without changing services:
+
+```sh
+./integration/scripts/build-macos.sh
+integration/test/test-pair-config.sh
+integration/test/test-audio-levels.sh
+integration/test/test-pair-routing.sh
+integration/test/test-wake-recovery.sh
+```
+
+Install the source-Mac services:
+
+```sh
+./integration/scripts/install-local.sh
+```
+
+The installer:
+
+- renders templates into `~/Library/Application Support/Snapcast/`;
+- keeps BlackHole and the built-in speaker at 100% hardware volume;
+- creates the left/right FIFOs;
+- installs the local LaunchAgents;
+- switches system output to BlackHole;
+- starts Snapserver, splitter, local Snapclient, route, pairing, and wake
+  recovery services.
+
+## Install the Remote Client
+
+Run from the source Mac after local installation:
+
+```sh
+./integration/scripts/install-remote.sh
+```
+
+This command resolves the remote home directory, renders the LaunchAgents for
+that account, copies Snapclient and the wake listener, and bootstraps
+`com.snapcast.remote-client` and `com.snapcast.remote-wake-recovery`.
+
+## Install the Optional Controller
+
+With the controller checked out beside this repository:
+
+```sh
+./integration/scripts/install-snapweb.sh
+```
+
+Or point to another checkout:
+
+```sh
+SNAPWEB_SOURCE=/path/to/snapweb-stereo-pair \
+  ./integration/scripts/install-snapweb.sh
+```
+
+The installer runs the controller's checks, copies its production build, and
+restarts Snapserver. Open `http://127.0.0.1:1780`.
+
+## Validate
+
+Run:
+
+```sh
+./integration/scripts/check-health.sh
+```
+
+Expected conditions:
+
+- `LeftAudio` and `RightAudio` both report `48000:24:1`.
+- Capture and local output hardware volumes both report `100.00%`.
+- `LeftAudio` lists the client role mapped to physical left.
+- `RightAudio` lists the client role mapped to physical right.
+- No recent `Not enough`, `age >`, `No chunk available`, or `onResync` warnings
+  appear in the local logs.
+- The controller shows two connected devices and a complete stereo stage.
+
+While BlackHole is the active macOS output, its volume slider controls the
+capture level rather than the built-in speakers. Use the controller volume for
+listening; the runtime normalizes both hardware stages to avoid double
+attenuation.
+
+CoreAudio applies the controller volume through the AudioQueue floating-point
+volume parameter. The 24-bit PCM received from Snapserver remains at full scale,
+so changing listening volume does not rewrite the integer audio buffer.
+
+## Complete Removal
+
+Return to native audio first:
+
+```sh
+~/Library/Application\ Support/Snapcast/set-mode.sh native
+```
+
+Stop all local Snapcast services:
+
+```sh
+uid="$(id -u)"
+for label in local-client capture server route splitter pairing wake-recovery; do
+  launchctl bootout "gui/$uid/com.snapcast.$label" 2>/dev/null || true
+done
+```
+
+Remove generated local files only after confirming their paths:
+
+```text
+~/Library/Application Support/Snapcast
+~/Library/Logs/Snapcast
+~/Library/LaunchAgents/com.snapcast.*.plist
+```
+
+The remote installer has no automatic uninstaller. On the remote Mac, boot out
+`com.snapcast.remote-client` and `com.snapcast.remote-wake-recovery`, then remove
+the copied binaries, scripts, and LaunchAgents after confirming the account and
+paths.
+
diff --git a/docs/troubleshooting.md b/docs/troubleshooting.md
new file mode 100644
index 00000000..5fb8265f
--- /dev/null
+++ b/docs/troubleshooting.md
@@ -0,0 +1,207 @@
+# Troubleshooting
+
+Start with:
+
+```sh
+./integration/scripts/check-health.sh
+```
+
+## Missing LeftAudio or RightAudio
+
+Confirm the stream format:
+
+```sh
+curl -fsS http://127.0.0.1:1780/jsonrpc \
+  -H 'Content-Type: application/json' \
+  --data '{"id":1,"jsonrpc":"2.0","method":"Server.GetStatus"}' |
+  jq '.result.server.streams[] | {id, sampleformat: .uri.query.sampleformat}'
+```
+
+Both streams must exist at `48000:24:1`. If the server is unavailable, inspect:
+
+```text
+~/Library/Logs/Snapcast/server.log
+~/Library/Logs/Snapcast/splitter.stderr.log
+```
+
+Restart the server and splitter:
+
+```sh
+uid="$(id -u)"
+launchctl kickstart -k "gui/$uid/com.snapcast.server"
+launchctl kickstart -k "gui/$uid/com.snapcast.splitter"
+```
+
+## FIFO Errors
+
+Check the named pipes:
+
+```sh
+ls -l "$HOME/Library/Application Support/Snapcast/run"
+```
+
+Both `left.pcm` and `right.pcm` should be FIFOs owned by the current user. If
+either is missing, rerun:
+
+```sh
+./integration/scripts/install-local.sh
+```
+
+Do not replace a FIFO with a regular file. A leftover splitter process can also
+hold a stale endpoint after server recovery; restart both services in the
+order shown above.
+
+## Streams Are Reversed
+
+Open:
+
+```text
+~/.config/snapcast-stereo-pair/pair.env
+```
+
+Set `LEFT_IS_REMOTE` to match physical placement:
+
+- `true` means the remote Mac is on the left.
+- `false` means the source Mac is on the left.
+
+Then reinstall the local runtime so templates and routing use the new roles:
+
+```sh
+./integration/scripts/install-local.sh
+```
+
+The controller derives the visible sides from `LeftAudio` and `RightAudio`, not
+from client IDs.
+
+## Local MacBook Is Silent
+
+In snapcast mode, the system output is BlackHole and applications are suspended
+from the speaker. The local Snapclient must select the built-in speaker
+explicitly.
+
+Verify:
+
+```sh
+SwitchAudioSource -c -t output
+launchctl print "gui/$(id -u)/com.snapcast.local-client"
+```
+
+The current system output should be `BlackHole 2ch`, and the local client should
+be running with `SNAPCLIENT_COREAUDIO_DEVICE` set. If the configured device UID
+is wrong, run `SwitchAudioSource -a -t output`, update
+`LOCAL_OUTPUT_DEVICE`, and reinstall.
+
+## One Side Is Much Quieter
+
+Run:
+
+```sh
+./integration/scripts/check-health.sh
+```
+
+Both hardware volume lines must report `100.00%`. BlackHole and the built-in
+speaker are separate CoreAudio devices: changing the macOS volume while
+BlackHole is selected does not change the speaker's hardware level.
+
+The volume helper writes both the virtual main volume (`vmvc`) and the physical
+main volume scalar (`volm`). Health checks report the lower of the two supported
+controls, because macOS can restore them independently after wake.
+
+Reapply the normalization:
+
+```sh
+"$HOME/Library/Application Support/Snapcast/route-audio.sh"
+```
+
+The runtime also reapplies this calibration while routing is active. Use the
+controller's volume after the hardware stages are normalized.
+
+The controller volume is applied by CoreAudio after the 24-bit PCM chunks have
+been decoded. The stream itself remains at full scale; lowering Snapcast volume
+does not rewrite or truncate the integer audio buffers.
+
+## Crackling, Dropouts, or Low Volume After Wake
+
+macOS can invalidate active CoreAudio queues during sleep and restore the
+speaker's physical volume separately from its virtual main volume. Both Macs
+therefore install a user wake-recovery service.
+
+Verify that it is running:
+
+```sh
+launchctl print "gui/$(id -u)/com.snapcast.wake-recovery"
+```
+
+The service waits briefly for CoreAudio to settle, re-selects BlackHole on the
+source Mac, writes both volume controls, and recreates the audio processes.
+The remote installer installs the equivalent service as
+`com.snapcast.remote-wake-recovery`.
+
+If a failure still occurs, collect
+`~/Library/Logs/Snapcast/wake-recovery.stderr.log` and any `snapclient` crash
+report produced around the wake time.
+
+## Dropouts or Periodic Gaps
+
+The validated 200 ms buffer covers normal Wi-Fi jitter. Symptoms include
+`Not enough`, `age >`, `No chunk available`, or `onResync` in recent logs.
+
+Check the pair before changing settings:
+
+```sh
+./integration/scripts/check-health.sh
+```
+
+Also check:
+
+- Both Macs remain on a stable LAN or VPN.
+- Only one Snapserver is running on the source Mac.
+- The selected source address is reachable from the remote Mac.
+- No duplicate Snapclient processes use the same role ID.
+- The wake-recovery LaunchAgents are running on both Macs.
+
+If the network genuinely needs a larger buffer, change `buffer` in
+[`integration/config/snapserver.conf.in`](../integration/config/snapserver.conf.in)
+and rerun the local installer. A smaller buffer increases underrun risk.
+
+## Audio/Video Offset
+
+Snapcast synchronization aligns the two audio clients with each other. The
+stream buffer adds intentional latency between the source application and both
+speakers.
+
+Keep both sides on the same runtime configuration and the same buffer. Changing
+one client's latency can improve a specific room compromise but breaks the
+left/right timing relationship.
+
+## Return to Native Audio
+
+Use the generated mode switcher:
+
+```sh
+~/Library/Application\ Support/Snapcast/set-mode.sh native
+```
+
+This stops and disables local services and restores the configured native output
+UID. To resume the pair:
+
+```sh
+~/Library/Application\ Support/Snapcast/set-mode.sh snapcast
+```
+
+The local script does not modify the remote Mac's installed LaunchAgent. With
+the server stopped, the remote client has no stream to play.
+
+## Collect a Safe Bug Report
+
+Include:
+
+- Runtime and controller release tags.
+- Mac model, CPU architecture, and macOS version.
+- BlackHole version.
+- Exact reproduction steps.
+- Redacted logs from around the failure.
+
+Do not post IP addresses, usernames, SSH details, credentials, `pair.env`, full
+home paths, or unredacted logs in a public issue.
+
diff --git a/docs/upstream-sync.md b/docs/upstream-sync.md
new file mode 100644
index 00000000..5a0a0f19
--- /dev/null
+++ b/docs/upstream-sync.md
@@ -0,0 +1,110 @@
+# Upstream Synchronization
+
+The public runtime keeps the upstream Snapcast history and adds a macOS
+stereo-pair integration layer on top of a release tag. Upstream remotes are:
+
+```text
+upstream https://github.com/snapcast/snapcast.git
+origin   https://github.com/damoqiongqiu/snapcast-stereo-pair.git
+```
+
+## Check the Current Bases
+
+```sh
+git remote -v
+git merge-base --is-ancestor v0.35.0 HEAD
+git log --oneline --decorate --graph -12
+```
+
+The first public integration base is Snapcast `v0.35.0`. The companion
+controller uses Snapweb `v0.9.3`.
+
+## Rebase the Project Layer
+
+Fetch upstream tags and replay the project commit onto the desired release:
+
+```sh
+git fetch upstream --tags
+git switch main
+git switch -c upgrade/snapcast-vX.Y.Z
+git rebase --onto vX.Y.Z v0.35.0
+```
+
+Resolve conflicts by preserving the project behavior described in
+[architecture.md](architecture.md):
+
+- CoreAudio output device selection through `SNAPCLIENT_COREAUDIO_DEVICE`.
+- Mono input expansion to a two-channel AudioQueue output.
+- Floating-point listening volume through `AudioQueueSetParameter` while PCM
+  chunks remain at full scale.
+- 20 ms CoreAudio buffering.
+- Initialized CoreAudio watchdog timing.
+- Process/pipe jitter tolerance and timeline preservation.
+- Deferred AudioQueue disposal outside its callback.
+- Source and remote wake-recovery services.
+- PortAudio BlackHole capture and dual mono FIFOs.
+- Normalization of both `vmvc` and `volm` hardware controls.
+- Role-based stream routing.
+
+When the upstream base tag changes, update this document, the README
+compatibility table, and CI expectations together.
+
+## Regenerate the Integration Patch
+
+After the rebased tree passes validation, regenerate the distributable diff:
+
+```sh
+git diff --binary vX.Y.Z -- . \
+  ':(exclude)integration/patches/snapcast-macos-stereo.patch' \
+  ':(exclude)docs/superpowers/**' \
+  > integration/patches/snapcast-macos-stereo.patch
+git apply --check --reverse integration/patches/snapcast-macos-stereo.patch
+```
+
+The reverse check confirms that the patch describes changes already present in
+the working tree. On a default case-insensitive macOS filesystem, the upstream
+case-only renames `changelog.md` and `.github/pull_request_template.md` can make
+the reverse check ambiguous. Exclude those paths when validating on such a
+checkout, or run the full reverse check in a case-sensitive checkout:
+
+```sh
+git apply --check --reverse \
+  --exclude=changelog.md \
+  --exclude=.github/pull_request_template.md \
+  integration/patches/snapcast-macos-stereo.patch
+```
+
+## Validate the Upgrade
+
+```sh
+./integration/scripts/build-macos.sh
+integration/test/test-pair-config.sh
+integration/test/test-audio-levels.sh
+integration/test/test-pair-routing.sh
+integration/test/test-wake-recovery.sh
+zsh -n integration/scripts/*.sh integration/test/*.sh
+plutil -lint integration/launchagents/*.plist.in
+./scripts/check-public-tree.sh
+```
+
+Build and run upstream unit tests:
+
+```sh
+cmake -S . -B .build-tests -G Ninja -DBUILD_SERVER=OFF -DBUILD_CLIENT=ON \
+  -DBUILD_TESTS=ON -DBUILD_WITH_SSL=OFF -DBUILD_SHARED_LIBS=OFF
+cmake --build .build-tests
+./bin/snapcast_test --reporter compact
+```
+
+Hardware acceptance still requires the two-MacBook setup. Verify both stream
+formats, routing, full-scale PCM with CoreAudio queue volume, `vmvc`/`volm`
+normalization, sleep/wake recovery, click-marker alignment, native-mode
+restoration, and controller compatibility before merging.
+
+## Privacy
+
+Local `pair.env` files, generated LaunchAgents, logs, build products, private IP
+addresses, usernames, credentials, and home paths must never enter a commit.
+Keep local configuration under `~/.config/snapcast-stereo-pair/` and run the
+public-tree scanner before publication.
+
diff --git a/integration/capture/capture-blackhole-pa.c b/integration/capture/capture-blackhole-pa.c
new file mode 100644
index 00000000..2434f671
--- /dev/null
+++ b/integration/capture/capture-blackhole-pa.c
@@ -0,0 +1,209 @@
+#include <portaudio.h>
+
+#include "fifo_io.h"
+#include "pcm24.h"
+
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static volatile sig_atomic_t running = 1;
+
+typedef struct
+{
+    const char* left_fifo;
+    const char* right_fifo;
+} CaptureOutputs;
+
+static void stop_capture(int signal_number)
+{
+    (void)signal_number;
+    running = 0;
+}
+
+static int parse_outputs(int argc, char** argv, CaptureOutputs* outputs)
+{
+    outputs->left_fifo = NULL;
+    outputs->right_fifo = NULL;
+
+    for (int i = 1; i < argc; ++i)
+    {
+        if ((strcmp(argv[i], "--left-fifo") == 0) && (i + 1 < argc))
+            outputs->left_fifo = argv[++i];
+        else if ((strcmp(argv[i], "--right-fifo") == 0) && (i + 1 < argc))
+            outputs->right_fifo = argv[++i];
+        else
+            return -1;
+    }
+
+    if ((outputs->left_fifo == NULL) != (outputs->right_fifo == NULL))
+        return -1;
+    return 0;
+}
+
+static int find_blackhole_input(void)
+{
+    const char* requested = getenv("CAPTURE_DEVICE");
+    if (requested == NULL || *requested == '\0')
+        requested = "BlackHole 2ch";
+
+    const int device_count = Pa_GetDeviceCount();
+    for (int i = 0; i < device_count; ++i)
+    {
+        const PaDeviceInfo* info = Pa_GetDeviceInfo(i);
+        if (info != NULL && info->maxInputChannels >= 2 && strstr(info->name, requested) != NULL)
+            return i;
+    }
+    return paNoDevice;
+}
+
+int main(int argc, char** argv)
+{
+    CaptureOutputs outputs;
+    if (parse_outputs(argc, argv, &outputs) != 0)
+    {
+        fprintf(stderr, "Usage: %s [--left-fifo PATH --right-fifo PATH]\n", argv[0]);
+        return 2;
+    }
+
+    signal(SIGINT, stop_capture);
+    signal(SIGTERM, stop_capture);
+    signal(SIGPIPE, SIG_IGN);
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    int left_fd = -1;
+    int right_fd = -1;
+    if (outputs.left_fifo != NULL)
+    {
+        left_fd = open(outputs.left_fifo, O_WRONLY);
+        right_fd = open(outputs.right_fifo, O_WRONLY);
+        if ((left_fd < 0) || (right_fd < 0))
+        {
+            fprintf(stderr, "Could not open capture FIFOs\n");
+            if (left_fd >= 0)
+                close(left_fd);
+            if (right_fd >= 0)
+                close(right_fd);
+            return 3;
+        }
+    }
+
+    PaError error = Pa_Initialize();
+    if (error != paNoError)
+    {
+        fprintf(stderr, "PortAudio init failed: %s\n", Pa_GetErrorText(error));
+        if (left_fd >= 0)
+            close(left_fd);
+        if (right_fd >= 0)
+            close(right_fd);
+        return 1;
+    }
+
+    const int device = find_blackhole_input();
+    if (device == paNoDevice)
+    {
+        fprintf(stderr, "BlackHole input device not found\n");
+        Pa_Terminate();
+        if (left_fd >= 0)
+            close(left_fd);
+        if (right_fd >= 0)
+            close(right_fd);
+        return 2;
+    }
+
+    const PaDeviceInfo* info = Pa_GetDeviceInfo(device);
+    const unsigned long frames_per_buffer = 480;
+    PaStreamParameters input_parameters;
+    memset(&input_parameters, 0, sizeof(input_parameters));
+    input_parameters.device = device;
+    input_parameters.channelCount = 2;
+    input_parameters.sampleFormat = paFloat32;
+    input_parameters.suggestedLatency = info->defaultLowInputLatency;
+    input_parameters.hostApiSpecificStreamInfo = NULL;
+
+    PaStream* stream = NULL;
+    error = Pa_OpenStream(&stream, &input_parameters, NULL, 48000, frames_per_buffer, paClipOff, NULL, NULL);
+    if (error != paNoError)
+    {
+        fprintf(stderr, "Could not open %s: %s\n", info->name, Pa_GetErrorText(error));
+        Pa_Terminate();
+        if (left_fd >= 0)
+            close(left_fd);
+        if (right_fd >= 0)
+            close(right_fd);
+        return 3;
+    }
+
+    error = Pa_StartStream(stream);
+    if (error != paNoError)
+    {
+        fprintf(stderr, "Could not start stream: %s\n", Pa_GetErrorText(error));
+        Pa_CloseStream(stream);
+        Pa_Terminate();
+        if (left_fd >= 0)
+            close(left_fd);
+        if (right_fd >= 0)
+            close(right_fd);
+        return 4;
+    }
+
+    if (left_fd >= 0)
+        fprintf(stderr, "Capturing %s at 48000 Hz into left/right 24-bit PCM FIFOs, 10 ms buffers\n", info->name);
+    else
+        fprintf(stderr, "Capturing %s at 48000 Hz, stereo float32 -> 24-bit PCM, 10 ms buffers\n", info->name);
+
+    float buffer[480 * 2];
+    int32_t pcm24[480 * 2];
+    int32_t left[480];
+    int32_t right[480];
+    int exit_code = 0;
+    while (running)
+    {
+        error = Pa_ReadStream(stream, buffer, frames_per_buffer);
+        if (error != paNoError && error != paInputOverflowed)
+        {
+            fprintf(stderr, "Capture read failed: %s\n", Pa_GetErrorText(error));
+            exit_code = 5;
+            break;
+        }
+
+        if (left_fd >= 0)
+        {
+            extractChannelS24In32(buffer, left, 480, AUDIO_CHANNEL_LEFT);
+            extractChannelS24In32(buffer, right, 480, AUDIO_CHANNEL_RIGHT);
+            if (!writeFully(left_fd, left, sizeof(left)))
+            {
+                fprintf(stderr, "Left FIFO write failed\n");
+                exit_code = 6;
+                break;
+            }
+            if (!writeFully(right_fd, right, sizeof(right)))
+            {
+                fprintf(stderr, "Right FIFO write failed\n");
+                exit_code = 6;
+                break;
+            }
+        }
+        else
+        {
+            floatToS24In32(buffer, pcm24, 480 * 2);
+            if (fwrite(pcm24, sizeof(pcm24), 1, stdout) != 1)
+            {
+                exit_code = 6;
+                break;
+            }
+        }
+    }
+
+    Pa_StopStream(stream);
+    Pa_CloseStream(stream);
+    Pa_Terminate();
+    if (left_fd >= 0)
+        close(left_fd);
+    if (right_fd >= 0)
+        close(right_fd);
+    return exit_code;
+}
diff --git a/integration/capture/fifo_io.h b/integration/capture/fifo_io.h
new file mode 100644
index 00000000..3a4a4a34
--- /dev/null
+++ b/integration/capture/fifo_io.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <unistd.h>
+
+static inline bool writeFully(int fd, const void* data, size_t bytes)
+{
+    const char* cursor = (const char*)data;
+    while (bytes > 0)
+    {
+        const ssize_t written = write(fd, cursor, bytes);
+        if (written < 0)
+        {
+            if (errno == EINTR)
+                continue;
+            return false;
+        }
+        if (written == 0)
+            return false;
+        cursor += written;
+        bytes -= (size_t)written;
+    }
+    return true;
+}
diff --git a/integration/capture/pcm24.h b/integration/capture/pcm24.h
new file mode 100644
index 00000000..afe21c08
--- /dev/null
+++ b/integration/capture/pcm24.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <math.h>
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+typedef enum
+{
+    AUDIO_CHANNEL_LEFT = 0,
+    AUDIO_CHANNEL_RIGHT = 1
+} AudioChannel;
+
+static inline int32_t floatToS24(float sample)
+{
+    float scaled = sample * 8388608.0F;
+    if (scaled != scaled)
+        return 0;
+    if (scaled >= 8388607.0F)
+        return 8388607;
+    if (scaled <= -8388608.0F)
+        return -8388608;
+    return (int32_t)lrintf(scaled);
+}
+
+static inline void floatToS24In32(const float* input, int32_t* output, size_t sample_count)
+{
+    for (size_t i = 0; i < sample_count; ++i)
+        output[i] = floatToS24(input[i]);
+}
+
+static inline void extractChannelS24In32(const float* stereo, int32_t* channel, size_t frames, AudioChannel side)
+{
+    const size_t offset = side == AUDIO_CHANNEL_LEFT ? 0 : 1;
+    for (size_t i = 0; i < frames; ++i)
+        channel[i] = floatToS24(stereo[i * 2 + offset]);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/integration/capture/set-audio-volume.c b/integration/capture/set-audio-volume.c
new file mode 100644
index 00000000..539443a3
--- /dev/null
+++ b/integration/capture/set-audio-volume.c
@@ -0,0 +1,227 @@
+/*
+ * Set or read a CoreAudio output device's virtual main volume by device UID.
+ *
+ * The source Mac uses BlackHole for capture while the local Snapclient renders
+ * to the built-in speaker. macOS exposes those as separate volume controls, so
+ * a normal "system volume" change can attenuate the wrong stage of the path.
+ */
+
+#include <CoreAudio/CoreAudio.h>
+#include <CoreFoundation/CoreFoundation.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const AudioObjectPropertySelector kVirtualMainVolume = 'vmvc';
+static const AudioObjectPropertySelector kMainVolume = 'volm';
+
+static void print_usage(FILE* stream, const char* program)
+{
+    fprintf(stream,
+            "Usage:\n"
+            "  %s get <device-uid>\n"
+            "  %s set <device-uid> <percent>\n"
+            "  %s inspect <device-uid>\n",
+            program,
+            program,
+            program);
+}
+
+static AudioDeviceID device_for_uid(const char* uid)
+{
+    CFStringRef uid_string = CFStringCreateWithCString(kCFAllocatorDefault, uid, kCFStringEncodingUTF8);
+    if (uid_string == NULL)
+        return kAudioObjectUnknown;
+
+    AudioObjectPropertyAddress address = {
+        kAudioHardwarePropertyTranslateUIDToDevice,
+        kAudioObjectPropertyScopeGlobal,
+        kAudioObjectPropertyElementMain,
+    };
+    AudioDeviceID device = kAudioObjectUnknown;
+    UInt32 size = sizeof(device);
+    OSStatus status = AudioObjectGetPropertyData(
+        kAudioObjectSystemObject, &address, sizeof(uid_string), &uid_string, &size, &device);
+    CFRelease(uid_string);
+
+    if (status != noErr)
+    {
+        fprintf(stderr, "Could not resolve device UID '%s': OSStatus %d\n", uid, status);
+        return kAudioObjectUnknown;
+    }
+    return device;
+}
+
+static AudioObjectPropertyAddress volume_address(AudioObjectPropertySelector selector, AudioObjectPropertyElement element)
+{
+    AudioObjectPropertyAddress address = {
+        selector,
+        kAudioObjectPropertyScopeOutput,
+        element,
+    };
+    return address;
+}
+
+static int read_volume_property(
+    AudioDeviceID device, AudioObjectPropertySelector selector, Float32* volume)
+{
+    AudioObjectPropertyAddress address = volume_address(selector, kAudioObjectPropertyElementMain);
+    if (AudioObjectHasProperty(device, &address))
+    {
+        UInt32 size = sizeof(*volume);
+        return AudioObjectGetPropertyData(device, &address, 0, NULL, &size, volume) == noErr;
+    }
+
+    int found = 0;
+    Float32 minimum = 1.0f;
+    for (AudioObjectPropertyElement element = 1; element <= 64; ++element)
+    {
+        address.mElement = element;
+        if (!AudioObjectHasProperty(device, &address))
+            continue;
+
+        Float32 channel_volume = 0;
+        UInt32 size = sizeof(channel_volume);
+        if (AudioObjectGetPropertyData(device, &address, 0, NULL, &size, &channel_volume) == noErr)
+        {
+            minimum = channel_volume < minimum ? channel_volume : minimum;
+            found = 1;
+        }
+    }
+
+    if (found)
+        *volume = minimum;
+    return found;
+}
+
+static int write_volume_property(
+    AudioDeviceID device, AudioObjectPropertySelector selector, Float32 volume)
+{
+    AudioObjectPropertyAddress address = volume_address(selector, kAudioObjectPropertyElementMain);
+    if (AudioObjectHasProperty(device, &address))
+        return AudioObjectSetPropertyData(device, &address, 0, NULL, sizeof(volume), &volume) == noErr;
+
+    int found = 0;
+    for (AudioObjectPropertyElement element = 1; element <= 64; ++element)
+    {
+        address.mElement = element;
+        if (!AudioObjectHasProperty(device, &address))
+            continue;
+
+        OSStatus status = AudioObjectSetPropertyData(device, &address, 0, NULL, sizeof(volume), &volume);
+        if (status != noErr)
+            return 0;
+        found = 1;
+    }
+    return found;
+}
+
+static int read_effective_volume(const char* uid)
+{
+    AudioDeviceID device = device_for_uid(uid);
+    if (device == kAudioObjectUnknown)
+        return 1;
+
+    Float32 virtual_main = 0;
+    Float32 main = 0;
+    const int has_virtual = read_volume_property(device, kVirtualMainVolume, &virtual_main);
+    const int has_main = read_volume_property(device, kMainVolume, &main);
+    if (!has_virtual && !has_main)
+    {
+        fprintf(stderr, "Device '%s' has no writable main volume control\n", uid);
+        return 1;
+    }
+
+    Float32 effective = 1.0f;
+    if (has_virtual && virtual_main < effective)
+        effective = virtual_main;
+    if (has_main && main < effective)
+        effective = main;
+
+    printf("%.2f\n", effective * 100.0);
+    return 0;
+}
+
+static int inspect_volume(const char* uid)
+{
+    AudioDeviceID device = device_for_uid(uid);
+    if (device == kAudioObjectUnknown)
+        return 1;
+
+    Float32 virtual_main = 0;
+    Float32 main = 0;
+    const int has_virtual = read_volume_property(device, kVirtualMainVolume, &virtual_main);
+    const int has_main = read_volume_property(device, kMainVolume, &main);
+    if (!has_virtual && !has_main)
+    {
+        fprintf(stderr, "Device '%s' has no writable main volume control\n", uid);
+        return 1;
+    }
+
+    if (has_virtual)
+        printf("virtual_main=%.2f\n", virtual_main * 100.0);
+    if (has_main)
+        printf("main=%.2f\n", main * 100.0);
+    return 0;
+}
+
+static int set_volume(const char* uid, const char* percent_text)
+{
+    char* end = NULL;
+    errno = 0;
+    double percent = strtod(percent_text, &end);
+    if (errno != 0 || end == percent_text || *end != '\0' || percent < 0 || percent > 100)
+    {
+        fprintf(stderr, "Volume must be a percentage between 0 and 100\n");
+        return 2;
+    }
+
+    AudioDeviceID device = device_for_uid(uid);
+    if (device == kAudioObjectUnknown)
+        return 1;
+
+    Float32 volume = (Float32)(percent / 100.0);
+    const int virtual_set = write_volume_property(device, kVirtualMainVolume, volume);
+    const int main_set = write_volume_property(device, kMainVolume, volume);
+    if (!virtual_set && !main_set)
+    {
+        fprintf(stderr, "Could not set volume for '%s'\n", uid);
+        return 1;
+    }
+
+    Float32 readback = 0;
+    if (virtual_set &&
+        (!read_volume_property(device, kVirtualMainVolume, &readback) || readback < volume - 0.001f || readback > volume + 0.001f))
+    {
+        fprintf(stderr, "Could not verify virtual main volume for '%s'\n", uid);
+        return 1;
+    }
+    if (main_set &&
+        (!read_volume_property(device, kMainVolume, &readback) || readback < volume - 0.001f || readback > volume + 0.001f))
+    {
+        fprintf(stderr, "Could not verify main volume for '%s'\n", uid);
+        return 1;
+    }
+
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc == 2 && strcmp(argv[1], "--help") == 0)
+    {
+        print_usage(stdout, argv[0]);
+        return 0;
+    }
+    if (argc == 3 && strcmp(argv[1], "get") == 0)
+        return read_effective_volume(argv[2]);
+    if (argc == 3 && strcmp(argv[1], "inspect") == 0)
+        return inspect_volume(argv[2]);
+    if (argc == 4 && strcmp(argv[1], "set") == 0)
+        return set_volume(argv[2], argv[3]);
+
+    print_usage(stderr, argv[0]);
+    return 2;
+}
diff --git a/integration/capture/wake-recovery-listener.c b/integration/capture/wake-recovery-listener.c
new file mode 100644
index 00000000..45057955
--- /dev/null
+++ b/integration/capture/wake-recovery-listener.c
@@ -0,0 +1,81 @@
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOMessage.h>
+#include <IOKit/pwr_mgt/IOPMLib.h>
+
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+extern char** environ;
+
+static io_connect_t root_port = MACH_PORT_NULL;
+static io_object_t power_notifier = IO_OBJECT_NULL;
+static IONotificationPortRef notification_port = NULL;
+static const char* recovery_script = NULL;
+static volatile sig_atomic_t running = 1;
+
+static void stop_listener(int signal_number)
+{
+    (void)signal_number;
+    running = 0;
+}
+
+static void run_recovery(void)
+{
+    pid_t child = 0;
+    char* argv[] = {(char*)recovery_script, NULL};
+    int error = posix_spawn(&child, recovery_script, NULL, NULL, argv, environ);
+    if (error != 0)
+        fprintf(stderr, "Could not start wake recovery script '%s': error %d\n", recovery_script, error);
+}
+
+static void power_callback(
+    void* context, io_service_t service, natural_t message_type, void* message_argument)
+{
+    (void)context;
+    (void)service;
+
+    if (message_type == kIOMessageCanSystemSleep || message_type == kIOMessageSystemWillSleep)
+    {
+        IOAllowPowerChange(root_port, (long)message_argument);
+    }
+    else if (message_type == kIOMessageSystemHasPoweredOn)
+    {
+        run_recovery();
+    }
+}
+
+int main(int argc, char** argv)
+{
+    if (argc != 2)
+    {
+        fprintf(stderr, "Usage: %s <wake-recovery-script>\n", argv[0]);
+        return 2;
+    }
+
+    recovery_script = argv[1];
+    signal(SIGINT, stop_listener);
+    signal(SIGTERM, stop_listener);
+
+    io_object_t notifier = IO_OBJECT_NULL;
+    root_port = IORegisterForSystemPower(&power_notifier, &notification_port, power_callback, &notifier);
+    if (root_port == MACH_PORT_NULL)
+    {
+        fprintf(stderr, "Could not register for system power notifications\n");
+        return 1;
+    }
+    power_notifier = notifier;
+
+    CFRunLoopSourceRef source = IONotificationPortGetRunLoopSource(notification_port);
+    CFRunLoopAddSource(CFRunLoopGetCurrent(), source, kCFRunLoopCommonModes);
+
+    while (running)
+        CFRunLoopRunInMode(kCFRunLoopDefaultMode, 1.0, false);
+
+    CFRunLoopRemoveSource(CFRunLoopGetCurrent(), source, kCFRunLoopCommonModes);
+    IODeregisterForSystemPower(&power_notifier);
+    IONotificationPortDestroy(notification_port);
+    return 0;
+}
