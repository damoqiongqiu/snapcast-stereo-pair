+#!/bin/zsh
+set -euo pipefail
+
+repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
+source "$repo_root/integration/scripts/pair-config.sh"
+
+config_file="$(pair_config_default_path)"
+mode="${1:-}"
+if [[ -f "$config_file" && "$mode" != "--force" && "$mode" != "--print" ]]; then
+  print "Configuration already exists: $config_file"
+  print "Use --force to replace it."
+  exit 0
+fi
+
+if [[ "${PAIR_NONINTERACTIVE:-0}" == "1" ]]; then
+  load_pair_config
+else
+  load_pair_config
+  read -r "REMOTE_USER?Remote SSH user: "
+  read -r "REMOTE_HOST?Remote Mac IP or hostname: "
+  read -r "SOURCE_HOST?Source Mac IP or hostname (blank for auto): "
+  read -r "LEFT_IS_REMOTE?Is the remote Mac physically on the left? [true/false] (true): "
+  [[ -n "$LEFT_IS_REMOTE" ]] || LEFT_IS_REMOTE=true
+fi
+
+if [[ -z "$SOURCE_HOST" ]]; then
+  SOURCE_HOST="$(detect_source_host || true)"
+fi
+require_pair_config
+compute_pair_roles
+
+if [[ "$mode" == "--print" ]]; then
+  print "REMOTE_USER=\"$REMOTE_USER\""
+  print "REMOTE_HOST=\"$REMOTE_HOST\""
+  print "SOURCE_HOST=\"$SOURCE_HOST\""
+  print "LEFT_IS_REMOTE=\"$LEFT_IS_REMOTE\""
+  print "CAPTURE_DEVICE=\"$CAPTURE_DEVICE\""
+  print "CAPTURE_DEVICE_UID=\"$CAPTURE_DEVICE_UID\""
+  print "LOCAL_OUTPUT_DEVICE=\"$LOCAL_OUTPUT_DEVICE\""
+  print "NATIVE_OUTPUT_DEVICE_UID=\"$NATIVE_OUTPUT_DEVICE_UID\""
+  print "REMOTE_OUTPUT_DEVICE_UID=\"$REMOTE_OUTPUT_DEVICE_UID\""
+  print "LOCAL_CLIENT_ID=\"$LOCAL_CLIENT_ID\""
+  print "REMOTE_CLIENT_ID=\"$REMOTE_CLIENT_ID\""
+  print "LEFT_CLIENT_ID=\"$LEFT_CLIENT_ID\""
+  print "RIGHT_CLIENT_ID=\"$RIGHT_CLIENT_ID\""
+  exit 0
+fi
+
+save_pair_config
+print "Wrote $config_file"
+print "Left client:  $LEFT_CLIENT_ID"
+print "Right client: $RIGHT_CLIENT_ID"
diff --git a/integration/scripts/ensure-pair-routing.sh b/integration/scripts/ensure-pair-routing.sh
new file mode 100755
index 00000000..58a29d15
--- /dev/null
+++ b/integration/scripts/ensure-pair-routing.sh
@@ -0,0 +1,90 @@
+#!/bin/zsh
+set -euo pipefail
+
+api="${SNAPSERVER_HTTP:-http://127.0.0.1:1780}"
+request_id=0
+LEFT_CLIENT_ID="${LEFT_CLIENT_ID:-@LEFT_CLIENT_ID@}"
+RIGHT_CLIENT_ID="${RIGHT_CLIENT_ID:-@RIGHT_CLIENT_ID@}"
+
+if [[ -f "@SUPPORT_DIR@/audio-levels.sh" ]]; then
+  source "@SUPPORT_DIR@/audio-levels.sh"
+  ensure_audio_levels || print -u2 "Could not normalize CoreAudio hardware levels"
+fi
+
+rpc() {
+  local payload="$1"
+  local response
+  response="$(curl -fsS "$api/jsonrpc" \
+    -H 'Content-Type: application/json' \
+    --data "$payload")" || return 1
+  print -r -- "$response" | jq -e 'has("result")' >/dev/null || {
+    print -u2 "Snapserver JSON-RPC error: $response"
+    return 1
+  }
+  print -r -- "$response"
+}
+
+next_id() {
+  request_id=$((request_id + 1))
+  print -r -- "$request_id"
+}
+
+group_for_client() {
+  local status_json="$1"
+  local client_id="$2"
+  print -r -- "$status_json" | jq -r --arg client_id "$client_id" '
+    .result.server.groups[]
+    | select(any(.clients[]; .id == $client_id and .connected == true))
+    | .id
+  ' | head -n 1
+}
+
+stream_for_group() {
+  local status_json="$1"
+  local group_id="$2"
+  print -r -- "$status_json" | jq -r --arg group_id "$group_id" '
+    .result.server.groups[]
+    | select(.id == $group_id)
+    | .stream_id
+  '
+}
+
+server_status="$(rpc "{\"id\":$(next_id),\"jsonrpc\":\"2.0\",\"method\":\"Server.GetStatus\"}")"
+
+both_connected="$(print -r -- "$server_status" | jq -r \
+  --arg left_id "$LEFT_CLIENT_ID" \
+  --arg right_id "$RIGHT_CLIENT_ID" '
+  ([.result.server.groups[].clients[] | select(.id == $left_id and .connected)] | length) == 1
+  and ([.result.server.groups[].clients[] | select(.id == $right_id and .connected)] | length) == 1
+')"
+if [[ "$both_connected" != "true" ]]; then
+  exit 0
+fi
+
+left_group="$(group_for_client "$server_status" "$LEFT_CLIENT_ID")"
+right_group="$(group_for_client "$server_status" "$RIGHT_CLIENT_ID")"
+
+if [[ -z "$left_group" || -z "$right_group" ]]; then
+  print -u2 "Could not resolve both stereo-pair groups"
+  exit 1
+fi
+
+if [[ "$left_group" == "$right_group" ]]; then
+  rpc "{\"id\":$(next_id),\"jsonrpc\":\"2.0\",\"method\":\"Group.SetClients\",\"params\":{\"id\":\"$left_group\",\"clients\":[\"$RIGHT_CLIENT_ID\"]}}" >/dev/null
+  server_status="$(rpc "{\"id\":$(next_id),\"jsonrpc\":\"2.0\",\"method\":\"Server.GetStatus\"}")"
+  left_group="$(group_for_client "$server_status" "$LEFT_CLIENT_ID")"
+  right_group="$(group_for_client "$server_status" "$RIGHT_CLIENT_ID")"
+fi
+
+if [[ -z "$left_group" || -z "$right_group" ]]; then
+  print -u2 "Could not resolve both stereo-pair groups"
+  exit 1
+fi
+
+if [[ "$(stream_for_group "$server_status" "$left_group")" != "LeftAudio" ]]; then
+  rpc "{\"id\":$(next_id),\"jsonrpc\":\"2.0\",\"method\":\"Group.SetStream\",\"params\":{\"id\":\"$left_group\",\"stream_id\":\"LeftAudio\"}}" >/dev/null
+fi
+
+if [[ "$(stream_for_group "$server_status" "$right_group")" != "RightAudio" ]]; then
+  rpc "{\"id\":$(next_id),\"jsonrpc\":\"2.0\",\"method\":\"Group.SetStream\",\"params\":{\"id\":\"$right_group\",\"stream_id\":\"RightAudio\"}}" >/dev/null
+fi
