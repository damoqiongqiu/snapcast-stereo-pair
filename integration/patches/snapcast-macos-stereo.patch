@@ -0,0 +1,76 @@
+name: Runtime bug report
+description: Report a capture, routing, playback, installation, or service defect
+title: "[Bug]: "
+labels: []
+body:
+  - type: markdown
+    attributes:
+      value: |
+        Do not include IP addresses, usernames, SSH details, passwords, keys,
+        tokens, `pair.env`, or full home-directory paths. Redact logs before posting.
+  - type: input
+    id: runtime-version
+    attributes:
+      label: Runtime version
+      description: Release tag or commit hash
+      placeholder: v0.1.0
+    validations:
+      required: true
+  - type: input
+    id: controller-version
+    attributes:
+      label: Controller version
+      description: Release tag or "not installed"
+      placeholder: v0.1.0
+    validations:
+      required: true
+  - type: input
+    id: environment
+    attributes:
+      label: Mac models, CPU architecture, and macOS versions
+      placeholder: MacBook Pro M4, Apple Silicon, macOS 27.2.1 (both Macs)
+    validations:
+      required: true
+  - type: input
+    id: blackhole
+    attributes:
+      label: BlackHole version and status
+      placeholder: BlackHole 2ch, device visible and selected on source Mac
+    validations:
+      required: true
+  - type: textarea
+    id: reproduction
+    attributes:
+      label: Reproduction steps
+      placeholder: |
+        1. Enter snapcast mode
+        2. Play a known test source
+        3. Observe...
+    validations:
+      required: true
+  - type: textarea
+    id: expected
+    attributes:
+      label: Expected behavior
+    validations:
+      required: true
+  - type: textarea
+    id: actual
+    attributes:
+      label: Actual behavior
+    validations:
+      required: true
+  - type: textarea
+    id: diagnostics
+    attributes:
+      label: Redacted diagnostics
+      description: Include relevant health output and recent logs with personal values removed.
+      render: text
+  - type: checkboxes
+    id: privacy
+    attributes:
+      label: Privacy confirmation
+      options:
+        - label: I removed personal network details, credentials, and home paths.
+          required: true
+
